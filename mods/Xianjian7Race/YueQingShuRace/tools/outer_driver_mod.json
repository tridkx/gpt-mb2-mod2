{
  "id": "YueQingShuRace",
  "package": "module/YueQingShuRace/AssetPackages/yqs.tpac",
  "cloth_diagnostics": {
    "enabled": true,
    "mode": "report",
    "probe": "build/cloth_probe/NativeClothProbe.dll",
    "targets": [
      {
        "metamesh": "yqs_body",
        "skeleton": "reports/final_skeleton.json",
        "capsules": "module/YueQingShuRace/ModuleData/cloth_bodies.xml",
        "body": "yqs_collision",
        "lods": [
          0,
          1,
          2,
          3
        ],
        "motions": [
          {
            "name": "ui_neutral_female",
            "path": "reports/ui_neutral_female.json",
            "fps": 60,
            "end": 61
          },
          {
            "name": "run",
            "path": "reports/run.json",
            "fps": 60
          },
          {
            "name": "riding",
            "path": "reports/riding.json",
            "fps": 60
          }
        ],
        "settings": {
          "warmup": 30,
          "substeps": 2,
          "iterations": 4
        }
      }
    ]
  }
}
