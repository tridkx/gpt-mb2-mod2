  "cloth_diagnostics": {
    "enabled": true,
    "mode": "report",
    "probe": "build/cloth_probe/NativeClothProbe.dll",
    "targets": [
      {
        "skeleton": "reports/final_skeleton.json",
        "capsules": "module/EmilieRace/ModuleData/cloth_bodies.xml",
        "body": "emilie_collision",
        "motions": [
          {
            "name": "facegen",
            "path": "reports/facegen.json",
            "fps": 60,
            "end": 61
          },
          {
            "name": "run",
            "path": "reports/run.json",
            "fps": 60
          },
          {
            "name": "riding",
            "path": "reports/riding.json",
            "fps": 60
          }
        ],
        "settings": {
          "warmup": 30,
          "substeps": 2,
          "iterations": 4
        },
        "metamesh": "emilie_body",
        "lods": [
          0,
          1,
          2,
          3
        ]
      },
      {
        "skeleton": "reports/final_skeleton.json",
        "capsules": "module/EmilieRace/ModuleData/cloth_bodies.xml",
        "body": "emilie_collision",
        "motions": [
